{"id": "en-final-08", "language": "en", "text": "Goodbye. See you later.", "frames": 69120, "nonfinite_samples": 0, "peak": 0.5550603270530701, "seconds": 7.744353485992178, "first_audio_seconds": 7.74422666800092, "first_sound_seconds": 8.176435001334253, "duration": 2.88, "rtf": 2.6890116270806175, "chunks": [{"ready": 7.74422666800092, "duration": 2.88}], "simulated_gap_seconds": 0, "sample_rate": 24000, "sha256": "249f6638684faaafd8635dba927535dc8aaeb9f00e17a65adb75831e8af90f94"}
{"id": "en-final-09", "language": "en", "text": "Translate goodbye into Japanese. Keep our conversation open.", "frames": 124800, "nonfinite_samples": 0, "peak": 0.3873555660247803, "seconds": 13.832825949008111, "first_audio_seconds": 13.832634026999585, "first_sound_seconds": 14.281467360332918, "duration": 5.2, "rtf": 2.6601588363477133, "chunks": [{"ready": 13.832634026999585, "duration": 5.2}], "simulated_gap_seconds": 0, "sample_rate": 24000, "sha256": "e4ad18786e73f6ec410a0fe8ead62e107b399525a97b509f5d6207c5fd5f2976"}
{"id": "en-final-10", "language": "en", "text": "Tell me the answer to one plus one.", "frames": 67200, "nonfinite_samples": 0, "peak": 0.5516045093536377, "seconds": 7.427526162005961, "first_audio_seconds": 7.427405934984563, "first_sound_seconds": 7.89444760165123, "duration": 2.8, "rtf": 2.652687915002129, "chunks": [{"ready": 7.427405934984563, "duration": 2.8}], "simulated_gap_seconds": 0, "sample_rate": 24000, "sha256": "b15d6a2d17072ca349a2d395719d7821cdfca806ae19737e79029b7fee8d6437"}
{"id": "en-final-11", "language": "en", "text": "Hello. It is raining today.", "frames": 80640, "nonfinite_samples": 0, "peak": 0.6317152976989746, "seconds": 8.672303670988185, "first_audio_seconds": 8.672170406993246, "first_sound_seconds": 9.103337073659912, "duration": 3.36, "rtf": 2.581042759222674, "chunks": [{"ready": 8.672170406993246, "duration": 3.36}], "simulated_gap_seconds": 0, "sample_rate": 24000, "sha256": "0532f1758cc1c1186c1e59dfb2f593501ef2c85f0dd776594e454e33fca780b9"}
{"id": "en-final-12", "language": "en", "text": "The forecast for tomorrow is cloudy.", "frames": 72960, "nonfinite_samples": 0, "peak": 0.5467864274978638, "seconds": 8.272259190009208, "first_audio_seconds": 8.272129712015158, "first_sound_seconds": 8.707379712015157, "duration": 3.04, "rtf": 2.7211378914503976, "chunks": [{"ready": 8.272129712015158, "duration": 3.04}], "simulated_gap_seconds": 0, "sample_rate": 24000, "sha256": "8e0cbb67cda967c172198ef60dbd31732013449a2afd903b0c5c90367e62b710"}
{"id": "en-final-13", "language": "en", "text": "Put one space between hello and today.", "frames": 107520, "nonfinite_samples": 0, "peak": 0.3265621066093445, "seconds": 12.265779684006702, "first_audio_seconds": 12.26561068900628, "first_sound_seconds": 12.699069022339614, "duration": 4.48, "rtf": 2.737897250894353, "chunks": [{"ready": 12.26561068900628, "duration": 4.48}], "simulated_gap_seconds": 0, "sample_rate": 24000, "sha256": "37e5c55bb39f542e1332d052f5349cf8a223f0b213e6e16924546c24e964b256"}
