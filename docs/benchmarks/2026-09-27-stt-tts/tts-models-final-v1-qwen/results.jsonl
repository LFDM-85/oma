{"id": "en-final-06", "language": "en", "text": "Close it without saving.", "frames": 65280, "nonfinite_samples": 0, "peak": 0.6782021522521973, "seconds": 7.111886553990189, "first_audio_seconds": 7.111778129998129, "first_sound_seconds": 7.553403129998129, "duration": 2.72, "rtf": 2.6146641742610988, "chunks": [{"ready": 7.111778129998129, "duration": 2.72}], "simulated_gap_seconds": 0, "sample_rate": 24000, "sha256": "e86bd5fdb9e060bbd1231f310af0c838695927cf7a8f5c4e600d75b5aafc3bcd"}
