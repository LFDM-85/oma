{"id": "ja-final-12", "language": "ja", "text": "明日の天気は曇りの予報です。", "seconds": 0.5455228619975969, "first_audio_seconds": 0.5420315740047954, "first_sound_seconds": 0.8934065740047954, "duration": 3.075, "chunks": [{"ready": 0.5420315740047954, "duration": 3.075}], "simulated_gap_seconds": 0, "peak": 17542, "frames": 73800}
