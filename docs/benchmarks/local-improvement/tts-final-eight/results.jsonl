{"id": "ja-final-01", "language": "ja", "text": "OmaTextで空の新規ファイルを開いてください。", "seconds": 0.6435919259965885, "first_audio_seconds": 0.5859668439952657, "first_sound_seconds": 0.9466335106619324, "duration": 3.925, "chunks": [{"ready": 0.5859668439952657, "duration": 3.925}], "simulated_gap_seconds": 0, "peak": 20011, "frames": 94200}
