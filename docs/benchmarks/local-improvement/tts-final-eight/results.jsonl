{"id": "ja-final-05", "language": "ja", "text": "今開いたファイルを閉じてください。", "seconds": 0.6845537119952496, "first_audio_seconds": 0.681149658979848, "first_sound_seconds": 1.0438996589798482, "duration": 3.0, "chunks": [{"ready": 0.681149658979848, "duration": 3.0}], "simulated_gap_seconds": 0, "peak": 20348, "frames": 72000}
