{"id": "ja-final-15", "language": "ja", "text": "その文字を消さずに改行してください。", "seconds": 0.5534695580136031, "first_audio_seconds": 0.5489282360067591, "first_sound_seconds": 0.8715949026734258, "duration": 3.5, "chunks": [{"ready": 0.5489282360067591, "duration": 3.5}], "simulated_gap_seconds": 0, "peak": 19288, "frames": 84000}
