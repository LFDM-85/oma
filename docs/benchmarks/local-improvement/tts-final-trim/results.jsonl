{"id": "ja-final-01", "language": "ja", "text": "OmaTextで空の新規ファイルを開いてください。", "seconds": 1.1279324289935175, "first_audio_seconds": 1.1240604179911315, "first_sound_seconds": 1.2966020846577981, "duration": 3.736666666666667, "chunks": [{"ready": 1.1240604179911315, "duration": 3.736666666666667}], "simulated_gap_seconds": 0, "peak": 19672, "frames": 89680}
