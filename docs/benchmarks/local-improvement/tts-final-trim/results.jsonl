{"id": "ja-final-10", "language": "ja", "text": "一足す一の答えを教えてください。", "seconds": 0.6529958200117107, "first_audio_seconds": 0.6475624559971038, "first_sound_seconds": 0.8146041226637705, "duration": 2.986666666666667, "chunks": [{"ready": 0.6475624559971038, "duration": 2.986666666666667}], "simulated_gap_seconds": 0, "peak": 24894, "frames": 71680}
