{"id": "ja-final-01", "language": "ja", "text": "OmaTextで空の新規ファイルを開いてください。", "seconds": 0.9133736999938264, "first_audio_seconds": 0.9096066229976714, "first_sound_seconds": 1.2703149563310048, "duration": 3.925, "chunks": [{"ready": 0.9096066229976714, "duration": 3.925}], "simulated_gap_seconds": 0, "peak": 20250, "frames": 94200}
