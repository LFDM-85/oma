{"id": "ja-final-05", "language": "ja", "text": "今開いたファイルを閉じてください。", "seconds": 0.6732901929935906, "first_audio_seconds": 0.669481556979008, "first_sound_seconds": 1.0322315569790081, "duration": 3.0, "chunks": [{"ready": 0.669481556979008, "duration": 3.0}], "simulated_gap_seconds": 0, "peak": 19745, "frames": 72000}
