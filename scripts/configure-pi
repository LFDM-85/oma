#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
# Use a neutral directory, not the user's current project and its extensions.
config_work="${OMA_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/oma}/model-setup"
mkdir -p "$config_work"
cd "$config_work"
if [[ "${1:-}" == "--advanced" ]]; then
  exec node "$root/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js" --no-extensions --no-skills --no-tools --no-context-files --no-prompt-templates --no-themes --no-session
fi
exec node "$root/runtime/connect-model.mjs"
